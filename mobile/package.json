{
  "name": "edump-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "node ../scripts/check-fonts.mjs --prepare",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "preandroid": "node ../scripts/check-fonts.mjs --prepare",
    "ios": "expo run:ios",
    "preios": "node ../scripts/check-fonts.mjs --prepare",
    "lint": "eslint . && tsc --noEmit",
    "test": "jest --ci --coverage --runInBand",
    "check-fonts": "node ../scripts/check-fonts.mjs --release",
    "eas-build-post-install": "node ../scripts/check-fonts.mjs --prepare --build",
    "web": "expo start --web",
    "export:web": "expo export --platform web --max-workers 1 && node ../scripts/prepare-web.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "expo": "55.0.31",
    "expo-asset": "55.0.20",
    "expo-build-properties": "55.0.18",
    "expo-constants": "55.0.17",
    "expo-dev-client": "55.0.40",
    "expo-device": "55.0.21",
    "expo-document-picker": "55.0.17",
    "expo-file-system": "55.0.26",
    "expo-font": "55.0.8",
    "expo-image": "55.0.11",
    "expo-intent-launcher": "55.0.16",
    "expo-linking": "55.0.17",
    "expo-notifications": "55.0.27",
    "expo-router": "55.0.18",
    "expo-secure-store": "55.0.18",
    "expo-sharing": "55.0.24",
    "expo-splash-screen": "55.0.25",
    "expo-system-ui": "55.0.22",
    "expo-updates": "~55.0.33",
    "lucide-react-native": "1.54.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.89.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "zod": "4.6.5",
    "zustand": "5.0.15"
