# development or production
APP_ENV=
# MongoDB connection string; readiness is unavailable when unset
MONGODB_URI=
# Database name (default edump)
MONGODB_DB=
# Base64 secret containing at least 32 random bytes (M1)
JWT_SECRET=
# Access token lifetime in minutes (M1)
ACCESS_TOKEN_TTL_MIN=
# Refresh token lifetime in days (M1)
REFRESH_TOKEN_TTL_DAYS=
# Full-match student email pattern (M1)
ALLOWED_EMAIL_REGEX=
# Comma-separated admin emails (M1)
ADMIN_EMAILS=
# Cloudflare account identifier (M3)
R2_ACCOUNT_ID=
# Bucket-scoped R2 access key (M3)
R2_ACCESS_KEY_ID=
# Bucket-scoped R2 secret key (M3)
R2_SECRET_ACCESS_KEY=
# Private bucket name (M3)
R2_BUCKET=
# Maximum upload size in MB (M3)
MAX_UPLOAD_MB=
# Per-user stored file quota in MB (default 500)
UPLOAD_QUOTA_MB=
# Presigned download lifetime in seconds (M3)
DOWNLOAD_URL_TTL_SEC=
# Optional Expo push access token (M4)
EXPO_PUSH_ACCESS_TOKEN=
