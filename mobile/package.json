  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "55.0.1",
    "jest": "30.5.2",
    "jest-expo": "55.0.22",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "react-dom": "19.2.0",
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
